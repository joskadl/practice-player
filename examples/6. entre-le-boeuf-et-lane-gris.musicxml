  <work>
    <work-title>Entre le bœuf et l'âne gris</work-title>
    </work>
  <movement-title>Entre le bœuf et l'âne gris</movement-title>
  <identification>
    <creator type="arranger">Felix de Nobel</creator>
    <creator type="lyricist">Traditional (France, 13th c.)</creator>
    <encoding>
      <software>MuseScore Studio 4.7.5</software>
      <encoding-date>2026-10-07</encoding-date>
      <supports element="accidental" type="yes"/>
      <supports element="beam" type="yes"/>
      <supports element="print" attribute="new-page" type="yes" value="yes"/>
      <supports element="print" attribute="new-system" type="yes" value="yes"/>
